#!/bin/bash
# no cd: a definition file path resolves against the caller's cwd, and
# everything named inside it against the definition file's own directory

PROJDIR=$(realpath "$(dirname "$(realpath "$0")")/..")

# lua 5.3 consults the versioned names before the plain ones, so set both.
# prepend rather than replace, or an existing luarocks tree stops resolving; the
# bare ";" stands in for lua's built-in default when the variable was unset.
export LUA_PATH_5_3="$PROJDIR/src/?.lua;${LUA_PATH_5_3:-${LUA_PATH:-;}}"
export LUA_CPATH_5_3="$PROJDIR/build/?.so;${LUA_CPATH_5_3:-${LUA_CPATH:-;}}"
export LUA_PATH="$LUA_PATH_5_3"
export LUA_CPATH="$LUA_CPATH_5_3"

# LUA_INIT is an interactive convenience.  a batch tool shouldn't pick up the
# user's repl helpers, and shouldn't die when they fail to load.
unset LUA_INIT LUA_INIT_5_3

exec lua5.3 "$PROJDIR/src/lettering.lua" "$@"
